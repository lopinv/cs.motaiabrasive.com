---
import { usePage, buildSeo } from '../../../lib/page.js'
import { langPaths } from '../../../lib/paths.js'
import Shell from '../../../components/Shell.astro'
import Breadcrumb from '../../../components/Breadcrumb.astro'
import { breadcrumbJsonLd, faqJsonLd } from '../../../lib/tdk.js'
import SectionHeading from '../../../components/SectionHeading.astro'
import CtaBand from '../../../components/CtaBand.astro'
import AccordionFaq from '../../../components/AccordionFaq.astro'
import Lightbox from '../../../components/Lightbox.astro'
import { discViews, products, media, quoteUrlRaw, faqMap } from '../../../lib/utils.js'

export function getStaticPaths() {
  return langPaths(discViews.map((d) => ({ key: d.key })))
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu, wa, discByKey } = usePage(lang)
const d = discByKey(ctx.key)
const t = pick('meta')
const dp = pick('discPage')
const goQuote = quoteUrlRaw({ disc_key: d.key })
const goSample = quoteUrlRaw({ disc_key: d.key, request_type: 'sample' })

// 砂纸片类 FAQ（通用 5 条 + 砂纸片 2 条），可见块与 JSON-LD 同源。
const q = [...faqMap.faq, ...(faqMap.byCategory['sanding discs'] ?? [])]
// 同族砂纸片产品内链：把变体页接到可报价的产品页。
const alsoLike = products.filter((p) => p.category === 'Sanding Discs').slice(0, 3)

const reviewed = new Intl.DateTimeFormat(lang.replace(/-(Hant|HanS)$/, ''), { dateStyle: 'long' }).format(new Date('2026-11-12'))

const seo = buildSeo(lang, 'disc', { key: d.key }, [
  breadcrumbJsonLd(lang, [
    { name: pick('colt.discs.label'), path: `/${lang}/collections/sanding-discs` },
    { name: d.title, path: `/${lang}/disc/${d.key}` }
  ]),
  faqJsonLd(lang, q)
])
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: 'Home', href: '/' }, { name: pick('colt.discs.label'), href: '/collections/sanding-discs' }, { name: d.title }]} />

  <section class="section wrap product-detail" data-group="d">
    <div>
      <div class="gallery">
        <div class="gallery-main lb-trigger" data-full={media(d.image)}>
          <img src={media(d.image)} alt={d.title} loading="eager" fetchpriority="high" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-fallback')" />
        </div>
      </div>
    </div>

    <div class="product-purchase">
      <span class="eyebrow">{dp.eyebrow}</span>
      <h1>{d.title}</h1>
      <div class="product-tags">
        <span>{t.wholesale}</span>
        <span>{t.oemNote}</span>
      </div>
      <div class="product-description">
        <p>{d.summary}</p>
        {(d.applications ?? []).length > 0 && (
          <div class="grit-chips">{d.applications.map((a) => <span>{a}</span>)}</div>
        )}
      </div>

      <details class="motai-product-specs" open>
        <summary>{pick('productPage.specTitle')}</summary>
        <table class="spec-table">
          <tbody>
            <tr><th scope="row">{t.holes}</th><td>{d.holes}</td></tr>
            <tr><th scope="row">{t.diameter}</th><td>{d.diameter}</td></tr>
            <tr><th scope="row">{t.material}</th><td>{d.abrasive}</td></tr>
            <tr><th scope="row">{t.backing}</th><td>{d.attachment}</td></tr>
          </tbody>
        </table>
        {(d.grits ?? []).length > 0 && (
          <div class="grit-chips">{d.grits.map((g) => <span>{g}</span>)}</div>
        )}
        {d.note && <p class="small-note">{d.note}</p>}
        {d.pendingNote && <p class="small-note">{d.pendingNote}</p>}
        <p class="small-note">{t.availability}</p>
      </details>

      <a class="button wide" href={goQuote} target="_blank" rel="noopener nofollow">
        {pick('cta.quote')} <span aria-hidden="true">↗</span>
      </a>
      <div class="motai-b2b-secondary-actions">
        <a class="button outline dark-outline wide" href={goSample} target="_blank" rel="noopener nofollow">{pick('cta.sample')}</a>
        <a class="button outline dark-outline wide" href={wa('disc', { title: d.title })} target="_blank" rel="noopener nofollow">{pick('cta.whatsapp')}</a>
      </div>
      <p class="byline">
        <span>{pick('article.reviewedBy')}</span>
        <span aria-hidden="true">·</span>
        <span>{pick('article.lastReviewed').replace('{date}', reviewed)}</span>
      </p>
    </div>
  </section>

  {q.length > 0 && (
    <section class="section wrap section--soft">
      <span class="eyebrow">FAQ</span>
      <h2>{pick('relArticles.faqTitle')}</h2>
      <p class="text-soft">{pick('relArticles.faqSub')}</p>
      <AccordionFaq
        items={q.map((item) => ({ q: pick(item.qKey), a: pick(item.aKey) })).filter((x) => x.q && x.a)}
        twoCol
      />
    </section>
  )}

  {alsoLike.length > 0 && (
    <section class="section wrap">
      <h2>{pick('relArticles.title')}</h2>
      <p class="text-soft">{pick('relArticles.sub')}</p>
      <div class="related-note">
        {alsoLike.map((x) => (
          <a href={lu(`/products/${x.handle}`)}>{x.name}</a>
        ))}
      </div>
    </section>
  )}

  <CtaBand lang={lang} waContext="disc" waVars={{ title: d.title }} ctaKey1="cta.quote" ctaKey2="cta.waChat" />

  <Lightbox
    viewFull={pick('productPage.viewFull')}
    closeViewer={pick('productPage.closeViewer')}
    prevImg={pick('productPage.prevImg')}
    nextImg={pick('productPage.nextImg')}
  />
</Shell>
