---
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/tdk.js'
import SectionHeading from '../../components/SectionHeading.astro'
import CtaBand from '../../components/CtaBand.astro'
import AccordionFaq from '../../components/AccordionFaq.astro'
import YouTubeEmbed from '../../components/YouTubeEmbed.astro'
import { visibleVideos, faq as faqData } from '../../lib/utils.js'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu, media, quoteUrl } = usePage(lang)
const f = pick('factory')
// 制造页的买家疑问与工厂能力直接相关（MOQ / OEM / 交期 / 包装），复用首页
// 同一份 faq.json 语料，可见块与 FAQPage schema 同源。
const q = faqData.faq
// Freshness 信号，与博客/产品页同一 E-E-A-T 口径。
const reviewed = new Intl.DateTimeFormat(lang.replace(/-(Hant|HanS)$/, ''), { dateStyle: 'long' }).format(new Date('2026-11-12'))
const seo = buildSeo(lang, 'factory', {}, [
  breadcrumbJsonLd(lang, [{ name: pick('nav.manufacturing'), path: `/${lang}/factory` }]),
  faqJsonLd(lang, q)
])
const processVideos = visibleVideos.filter((v) => v.line === 'belts' && v.kind === 'video')
const video = processVideos[0]
const vTitle = video?.youtubeId ? pick(video.titleKey) : ''
const vDesc = video?.youtubeId ? pick(video.descriptionKey) : ''
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: 'Home', href: '/' }, { name: pick('nav.manufacturing'), href: '/factory' }]} />
  <section class="section wrap">
    <span class="eyebrow">MANUFACTURING &amp; QUALITY</span>
    <h1>{f.h1}</h1>
    <p class="lead">{f.sub}</p>
    <p class="body-narrow mt-12">{f.intro}</p>
    {video?.youtubeId && (
      <a class="button outline dark-outline mt-18" href={quoteUrl()} target="_blank" rel="noopener nofollow">{f.videoLabel} <span aria-hidden="true">↗</span></a>
    )}
  </section>

  {video?.youtubeId && (
    <section class="section wrap section--soft-tight">
      <div class="narrow">
        <YouTubeEmbed video={video} title={vTitle} description={vDesc} />
      </div>
    </section>
  )}

  <section class="section wrap section--soft-tight">
    <SectionHeading title={f.galleryTitle} sub={f.galleryIntro} />
    <div class="grid grid-3">
      <div class="value-card">
        <div class="gallery-media"><img src={media('factory')} alt={f.gallery1Title} loading="lazy" onerror="this.onerror=null;this.parentElement.classList.add('img-fallback')" /></div>
        <h3>{f.gallery1Title}</h3>
        <p>{f.gallery1Text}</p>
      </div>
      <div class="value-card">
        <div class="gallery-media"><img src={media('workshop')} alt={f.gallery2Title} loading="lazy" onerror="this.onerror=null;this.parentElement.classList.add('img-fallback')" /></div>
        <h3>{f.gallery2Title}</h3>
        <p>{f.gallery2Text}</p>
      </div>
      <div class="value-card">
        <div class="gallery-media"><img src={media('discs')} alt={f.gallery3Title} loading="lazy" onerror="this.onerror=null;this.parentElement.classList.add('img-fallback')" /></div>
        <h3>{f.gallery3Title}</h3>
        <p>{f.gallery3Text}</p>
      </div>
    </div>
    <p class="small-note mt-18">{f.galleryNote}</p>
  </section>

  <section class="section wrap">
    <SectionHeading title={f.stepsTitle} sub={f.stepsIntro} />
    <div class="steps">
      <div class="step"><b>01</b><div><h3>{f.st1t}</h3><p>{f.st1b}</p></div></div>
      <div class="step"><b>02</b><div><h3>{f.st2t}</h3><p>{f.st2b}</p></div></div>
      <div class="step"><b>03</b><div><h3>{f.st3t}</h3><p>{f.st3b}</p></div></div>
      <div class="step"><b>04</b><div><h3>{f.st4t}</h3><p>{f.st4b}</p></div></div>
    </div>
    <p class="small-note">{f.imgNote}</p>
    <p class="byline">
      <span>{pick('article.reviewedBy')}</span>
      <span aria-hidden="true">·</span>
      <span>{pick('article.lastReviewed').replace('{date}', reviewed)}</span>
    </p>
  </section>

  <section class="section wrap section--soft">
    <span class="eyebrow">FAQ</span>
    <h2>{pick('relArticles.faqTitle')}</h2>
    <p class="text-soft">{pick('relArticles.faqSub')}</p>
    <AccordionFaq
      items={q.map((item) => ({ q: pick(item.qKey), a: pick(item.aKey) })).filter((x) => x.q && x.a)}
      twoCol
    />
  </section>

  <section class="section wrap">
    <span class="eyebrow">QC</span>
    <SectionHeading title={f.qcTitle} sub={f.qcIntro} />
    <div class="grid grid-3">
      <div class="value-card"><span class="vno">QC-1</span><h3>{f.qc1t}</h3><p>{f.qc1b}</p></div>
      <div class="value-card"><span class="vno">QC-2</span><h3>{f.qc2t}</h3><p>{f.qc2b}</p></div>
      <div class="value-card"><span class="vno">QC-3</span><h3>{f.qc3t}</h3><p>{f.qc3b}</p></div>
    </div>
  </section>

  <CtaBand lang={lang} title={f.ctaTitle} body={f.ctaSub} waContext="factory" ctaKey1="factory.cta1" ctaKey2="factory.cta2" />
</Shell>
