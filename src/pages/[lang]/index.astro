---
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import Home from '../../components/pages/Home.astro'
import { breadcrumbJsonLd, faqJsonLd, websiteJsonLd } from '../../lib/tdk.js'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const ctx = Astro.params
const { org, faq } = usePage(lang)
const seo = buildSeo(lang, 'home')
// Home renders a visible FAQ section (Home.astro) — emit the matching FAQPage
// JSON-LD plus a WebSite node, both on the localized home page.
const jsonld = [
  ...(seo.jsonld ?? []),
  breadcrumbJsonLd(lang, []),
  faqJsonLd(lang, faq.faq),
  websiteJsonLd()
]
---

<Shell lang={lang} seo={{ ...seo, jsonld }}>
  <Home lang={lang} />
</Shell>
