---
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/tdk.js'
import SectionHeading from '../../components/SectionHeading.astro'
import CtaBand from '../../components/CtaBand.astro'
import AccordionFaq from '../../components/AccordionFaq.astro'
import { regions, trust, faq as faqData } from '../../lib/utils.js'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const { pick, lu, wa } = usePage(lang)
const c = pick('clients')
const t = pick('trust')
const clients = trust.clients.filter((x) => x.status === 'placeholder')
const stats = trust.stats.filter((x) => x.status === 'published')
// FAQ items resolve through the locale file; qKey/aKey let faqJsonLd localise.
const faqKeys = ['f1', 'f2', 'f3', 'f4']
const faqItems = faqKeys.map((k) => ({
  qKey: `clients.${k}`,
  aKey: `clients.fa${k.slice(1)}`,
  q: pick(`clients.${k}`),
  a: pick(`clients.fa${k.slice(1)}`)
})).filter((f) => f.q && f.a)

const seo = buildSeo(lang, 'clients', {}, [
  breadcrumbJsonLd(lang, [{ name: c.h1, path: `/${lang}/clients` }]),
  faqItems.length ? faqJsonLd(lang, faqItems) : null
])

const logistics = [c.l1, c.l2, c.l3, c.l4].filter(Boolean)
const qa = [c.q1, c.q2, c.q3].filter(Boolean)
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: 'Home', href: '/' }, { name: c.h1 }]} />

  <section class="section wrap">
    <span class="eyebrow">GLOBAL SUPPLY</span>
    <h1>{c.h1}</h1>
    <p class="lead">{c.sub}</p>
  </section>

  <section class="section wrap section--soft-tight">
    <SectionHeading title={c.statsTitle} />
    <div class="stats-grid">
      {stats.map((s) => (
        <div class="value-card value-card--center">
          <div class="stat-value">{s.value}</div>
          <div class="stat-label">{pick(s.labelKey)}</div>
        </div>
      ))}
    </div>
    <p class="small-note mt-14">{c.statsNote}</p>
  </section>

  <section class="section wrap section--flush-top">
    <SectionHeading eyebrow="DESTINATIONS" title={c.regionsTitle} sub={c.regionsSub} />
    <div class="grid grid-3">
      {regions.map((r) => (
        <div class="region-card">
          <h3>{pick(r.titleKey)}</h3>
          <p>{pick(r.bodyKey)}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap section--soft">
    <SectionHeading eyebrow="BEFORE DISPATCH" title={c.logisticsTitle} sub={c.logisticsSub} />
    <div class="grid grid-2">
      {logistics.map((text) => (
        <div class="value-card">
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <SectionHeading eyebrow="CHECKLIST" title={c.qaTitle} sub={c.qaSub} />
    <div class="value-card">
      <ul class="value-lines">
        {qa.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  {faqItems.length > 0 && (
    <section class="section wrap section--soft">
      <SectionHeading title={c.faqTitle} />
      {faqItems.length > 0 && <AccordionFaq items={faqItems.map((f) => ({ q: f.q, a: f.a })).filter((x) => x.q && x.a)} />}
    </section>
  )}

  <section class="section wrap section--soft">
    <SectionHeading title="Partners & references" />
    <p class="small-note">{c.note}</p>
    <div class="grid grid-4 mt-18">
      {clients.map((cl) => (
        <div class="logo-slot">
          <div>
            <span class="placeholder-badge">{c.placeholderBadge}</span>
            <p>{cl.name}</p>
            <p class="small-note">{cl.region}</p>
          </div>
        </div>
      ))}
    </div>
    <p class="small-note mt-18">{c.statsNote}</p>
  </section>

  <CtaBand lang={lang} waContext="contact" ctaKey1="cta.quote" ctaKey2="cta.waChat" />
</Shell>
