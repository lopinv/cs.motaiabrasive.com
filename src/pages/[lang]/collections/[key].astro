---
import { usePage, buildSeo } from '../../../lib/page.js'
import { langPaths } from '../../../lib/paths.js'
import Shell from '../../../components/Shell.astro'
import Breadcrumb from '../../../components/Breadcrumb.astro'
import { breadcrumbJsonLd, collectionItemListJsonLd, faqJsonLd } from '../../../lib/tdk.js'
import SectionHeading from '../../../components/SectionHeading.astro'
import ProductCard from '../../../components/ProductCard.astro'
import CtaBand from '../../../components/CtaBand.astro'
import AccordionFaq from '../../../components/AccordionFaq.astro'
import { products, models, discViews, flaps, sponges, media } from '../../../lib/utils.js'

export function getStaticPaths() {
  return langPaths(['abrasive-belts', 'sanding-discs', 'flap-discs', 'sanding-sponges', 'all'].map((key) => ({ key })))
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu, wa } = usePage(lang)
const { key } = ctx
const coltKey = { 'abrasive-belts': 'belts', 'sanding-discs': 'discs', 'flap-discs': 'flap', 'sanding-sponges': 'sponge', all: 'all' }[key]
const isAll = key === 'all'
const t = { title: pick(`colt.${coltKey}.title`), description: pick(`colt.${coltKey}.desc`) }
const beltProducts = products.filter((p) => p.category === 'Abrasive Belts')
const discProducts = products.filter((p) => p.category === 'Sanding Discs')
// Products actually rendered on this collection page, as ItemList entries.
// Order follows the visible page order: on the belts/discs collection pages
// the reference-model / variant block comes first, so its entries are pushed
// first and the ItemList `position` matches what the reader sees.
const items = []
if (key === 'abrasive-belts' || isAll) {
  if (key === 'abrasive-belts') items.push(...models.map((m) => ({ name: `Abrasive belt model ${m.model}`, image: m.image, path: `/model/${m.slug}`, sku: m.model, category: 'Abrasive Belts' })))
  items.push(...beltProducts.map((p) => ({ name: p.name, image: p.image, path: `/products/${p.handle}`, sku: p.handle, category: p.category })))
}
if (key === 'sanding-discs' || isAll) {
  if (key === 'sanding-discs') items.push(...discViews.map((d) => ({ name: d.title, image: d.image, path: `/disc/${d.key}`, sku: d.key, category: 'Sanding Discs' })))
  items.push(...discProducts.map((p) => ({ name: p.name, image: p.image, path: `/products/${p.handle}`, sku: p.handle, category: p.category })))
}
if (key === 'flap-discs' || isAll) {
  items.push(...flaps.map((f) => ({ name: f.name, image: f.image, path: `/flap/${f.key}`, sku: f.key, category: 'Flap Discs' })))
}
if (key === 'sanding-sponges' || isAll) {
  items.push(...sponges.map((s) => ({ name: s.name, image: s.image, path: `/sponge/${s.key}`, sku: s.key, category: 'Sanding Sponges' })))
}
// Buying-guide copy for this line, resolved from coltBuy.<line> in the locale
// file. Each entry carries qKey/aKey so faqJsonLd resolves the localized text.
const b = pick('coltBuy')
const faqLine = pick(`coltBuy.${coltKey}`) || []
const faqItems = (Array.isArray(faqLine) ? faqLine : []).map((f, i) => ({
  qKey: `coltBuy.${coltKey}[${i}].q`,
  aKey: `coltBuy.${coltKey}[${i}].a`,
  q: f.q,
  a: f.a
})).filter((f) => f.q && f.a)

const seo = buildSeo(lang, 'collection', { key: isAll ? 'all' : key }, [
  breadcrumbJsonLd(lang, [
    { name: pick('nav.products'), path: `/${lang}/collections/all` },
    { name: t, path: `/${lang}/collections/${key}` }
  ]),
  collectionItemListJsonLd(lang, items),
  faqItems.length ? faqJsonLd(lang, faqItems) : null
])
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: 'Home', href: '/' }, { name: pick('colt.all.label'), href: '/collections/all' }, { name: t.title }]} />

  <section class="section wrap">
    <span class="eyebrow">COLLECTION</span>
    <h1>{t.title}</h1>
  </section>

  <div class="section wrap section--flush-top">
    {(key === 'abrasive-belts' || isAll) && (
      <>
        {key === 'abrasive-belts' && (
          <>
            <SectionHeading title={pick('modelPage.eyebrow')} />
            <div class="grid grid-3">
              {models.map((m) => (
                <a class="model-card" href={lu(`/model/${m.slug}`)}>
                  <span class="mno">{m.model}</span>
                  <h3>{m.model}</h3>
                  <p>{m.family}</p>
                  {m.image && (
                    <div class="model-card-media">
                      <img src={media(m.image)} alt={m.model} loading="lazy" onerror="this.onerror=null;this.style.display='none'" />
                    </div>
                  )}
                </a>
              ))}
            </div>
          </>
        )}
        <SectionHeading title={`${pick('colt.belts.label')} — ${t.title}`} />
        <div class="grid grid-4">
          {beltProducts.map((p) => (
            <ProductCard lang={lang} title={p.name} subtitle={p.category} imageKey={p.image} link={lu(`/products/${p.handle}`)} />
          ))}
        </div>
      </>
    )}

    {(key === 'sanding-discs' || isAll) && (
      <>
        {key === 'sanding-discs' && (
          <>
            <SectionHeading title={pick('discPage.eyebrow')} />
            <div class="grid grid-3">
              {discViews.map((d) => (
                <a class="model-card" href={lu(`/disc/${d.key}`)}>
                  <span class="mno">{d.key.toUpperCase()}</span>
                  <h3>{d.title}</h3>
                  <p>{(d.grits ?? []).join(' · ') || pick('meta.diameter')}</p>
                  {d.image && (
                    <div class="model-card-media">
                      <img src={media(d.image)} alt={d.title} loading="lazy" onerror="this.onerror=null;this.style.display='none'" />
                    </div>
                  )}
                </a>
              ))}
            </div>
          </>
        )}
        <SectionHeading title={`${pick('colt.discs.label')} — ${t.title}`} />
        <div class="grid grid-4">
          {discProducts.map((p) => (
            <ProductCard lang={lang} title={p.name} subtitle={p.category} imageKey={p.image} link={lu(`/products/${p.handle}`)} />
          ))}
        </div>
      </>
    )}

    {(key === 'flap-discs' || isAll) && (
      <>
        <SectionHeading title={`${pick('colt.flap.label')} — ${t.title}`} />
        <div class="grid grid-3">
          {flaps.map((f) => (
            <a class="product-card" href={lu(`/flap/${f.key}`)}>
              <div class="product-card-media">
                <img src={media(f.image)} alt={f.name} loading="lazy" onerror="this.onerror=null;this.style.display='none'" />
                <span class="img-fallback-text" aria-hidden="true">{f.backing}</span>
              </div>
              <div class="product-card-body">
                <span class="eyebrow">{f.color}</span>
                <h3 class="product-card-title">{f.name}</h3>
                <p>{f.backing} backing</p>
              </div>
            </a>
          ))}
        </div>
      </>
    )}

    {(key === 'sanding-sponges' || isAll) && (
      <>
        <SectionHeading title={`${pick('colt.sponge.label')} — ${t.title}`} />
        <div class="grid grid-3">
          {sponges.map((s) => (
            <a class="product-card" href={lu(`/sponge/${s.key}`)}>
              <div class="product-card-media">
                <img src={media(s.image)} alt={s.name} loading="lazy" onerror="this.onerror=null;this.style.display='none'" />
                <span class="img-fallback-text" aria-hidden="true">{s.family}</span>
              </div>
              <div class="product-card-body">
                <span class="eyebrow">{s.thickness}</span>
                <h3 class="product-card-title">{s.name}</h3>
                <p>{s.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </>
    )}
  </div>

  <section class="section wrap section--soft">
    <SectionHeading eyebrow="SELECTION" title={b.guideTitle} sub={b.guideSub} />
    <div class="grid grid-2">
      <div class="value-card">
        <span class="vno">01</span>
        <h3>{t.title}</h3>
        <p class="value-lines">{t.description}</p>
      </div>
      <div class="value-card">
        <span class="vno">02</span>
        <h3>{b.specTitle}</h3>
        <p>{b.specSub}</p>
        <p class="value-lines mt-12">
          {coltKey === 'belts' && <>533 × 75 mm<br />610 × 100 mm<br />1520 × 630 mm<br />2200 × 1330 mm</>}
          {coltKey === 'discs' && <>3-inch<br />4-inch<br />5-inch<br />6-inch</>}
          {coltKey === 'flap' && <>Plastic backing<br />Steel backing<br />Fiberglass backing</>}
          {coltKey === 'sponge' && <>Flexible pads — thin<br />Foam blocks — thick<br />Multi-grit, double-sided wear<br />Die-cut and OEM packing</>}
          {coltKey === 'all' && <>Abrasive belts<br />Sanding discs<br />Flap discs<br />Sanding sponges</>}
        </p>
      </div>
    </div>
  </section>

  {faqItems.length > 0 && (
    <section class="section wrap">
      <SectionHeading title={b.faqTitle} />
      {faqItems.length > 0 && <AccordionFaq items={faqItems.map((f) => ({ q: f.q, a: f.a })).filter((x) => x.q && x.a)} />}
    </section>
  )}

  <CtaBand lang={lang} waContext="generic" ctaKey1="cta.quote" ctaKey2="cta.waChat" />
</Shell>
