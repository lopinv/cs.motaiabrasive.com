---
import { usePage, buildSeo } from '../../../lib/page.js'
import { langPaths } from '../../../lib/paths.js'
import Shell from '../../../components/Shell.astro'
import Breadcrumb from '../../../components/Breadcrumb.astro'
import { breadcrumbJsonLd, faqJsonLd } from '../../../lib/tdk.js'
import SectionHeading from '../../../components/SectionHeading.astro'
import CtaBand from '../../../components/CtaBand.astro'
import AccordionFaq from '../../../components/AccordionFaq.astro'
import Lightbox from '../../../components/Lightbox.astro'
import { models, media, quoteUrlRaw, faqMap } from '../../../lib/utils.js'

export function getStaticPaths() {
  return langPaths(models.map((m) => ({ slug: m.slug })))
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu, wa, modelBySlug } = usePage(lang)
const m = modelBySlug(ctx.slug)
const t = pick('meta')
const mp = pick('modelPage')
const goQuote = quoteUrlRaw({ model: m.model })
const goSample = quoteUrlRaw({ model: m.model, request_type: 'sample' })

// Belt FAQ: 问的是砂带选型的通用疑问，问法与型号页的定位一致。可见块与
// FAQPage JSON-LD 由同一列表产出，避免两侧不一致。
const q = [...faqMap.faq, ...(faqMap.byCategory['abrasive belts'] ?? [])]

// Freshness byline，与博客文章页同一个 E-E-A-T 信号源。
const reviewed = new Intl.DateTimeFormat(lang.replace(/-(Hant|HanS)$/, ''), { dateStyle: 'long' }).format(new Date('2026-11-12'))

const seo = buildSeo(lang, 'model', { slug: m.slug }, [
  breadcrumbJsonLd(lang, [
    { name: pick('colt.belts.label'), path: `/${lang}/collections/abrasive-belts` },
    { name: m.model, path: `/${lang}/model/${m.slug}` }
  ]),
  faqJsonLd(lang, q)
])
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: pick('colt.belts.label'), href: '/collections/abrasive-belts' }, { name: m.model }]} />

  <section class="section wrap product-detail" data-group="m">
    <div>
      <div class="gallery">
        <div class="gallery-main lb-trigger" data-full={media(m.image ?? 'belt-533-75')}>
          <img src={media(m.image ?? 'belt-533-75')} alt={`${m.model} ${pick('modelPage.eyebrow')}`} loading="eager" fetchpriority="high" onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-fallback')" />
        </div>
      </div>
    </div>

    <div class="product-purchase">
      <span class="eyebrow">{mp.eyebrow}</span>
      <h1>{m.model}</h1>
      <div class="product-tags">
        <span>{mp.refLabel}: {m.model}</span>
        <span>{mp.familyLabel}: {m.family}</span>
      </div>
      <div class="product-description">
        <p>{m.summary}</p>
        {(m.applications ?? []).length > 0 && (
          <div class="grit-chips">{m.applications.map((a) => <span>{a}</span>)}</div>
        )}
      </div>

      <details class="motai-product-specs" open>
        <summary>{pick('productPage.specTitle')}</summary>
        <table class="spec-table">
          <tbody>
            <tr><th scope="row">{mp.dimsLabel}</th><td>{pick('modelPage.dimsPlaceholder')}</td></tr>
            <tr><th scope="row">{mp.gritLabel}</th><td>{pick('modelPage.gritPlaceholder')}</td></tr>
            <tr><th scope="row">{mp.grainBacking}</th><td>{pick('modelPage.disclaimer').split('.')[0]}.</td></tr>
          </tbody>
        </table>
        {m.note && <p class="small-note">{m.note}</p>}
        <p class="small-note">{t.availability}</p>
      </details>

      <a class="button wide" href={goQuote} target="_blank" rel="noopener nofollow">
        {pick('cta.quote')} <span aria-hidden="true">↗</span>
      </a>

      <div class="motai-b2b-secondary-actions">
        <a class="button outline dark-outline wide" href={goSample} target="_blank" rel="noopener nofollow">{pick('cta.sample')}</a>
        <a class="button outline dark-outline wide" href={wa('model', { model: m.model })} target="_blank" rel="noopener nofollow">{pick('cta.whatsapp')}</a>
      </div>
      <p class="byline">
        <span>{pick('article.reviewedBy')}</span>
        <span aria-hidden="true">·</span>
        <span>{pick('article.lastReviewed').replace('{date}', reviewed)}</span>
      </p>
    </div>
  </section>

  {q.length > 0 && (
    <section class="section wrap section--soft">
      <span class="eyebrow">FAQ</span>
      <h2>{pick('relArticles.faqTitle')}</h2>
      <p class="text-soft">{pick('relArticles.faqSub')}</p>
      <AccordionFaq
        items={q.map((item) => ({ q: pick(item.qKey), a: pick(item.aKey) })).filter((x) => x.q && x.a)}
        twoCol
      />
    </section>
  )}

  <section class="section wrap section--soft">
    <SectionHeading eyebrow="REFERENCE" title={pick('home.beltsShowTitle')} />
    <p class="soft-body">{mp.discussion}</p>
    <div class="grid grid-3 mt-24">
      {models.slice(0, 6).map((x) => (
        <a class="model-card" href={lu(`/model/${x.slug}`)}>
          <span class="mno">{x.family}</span>
          <h3>{x.model}</h3>
          {x.image && (
            <div class="model-card-media">
              <img src={media(x.image)} alt={x.model} loading="lazy" onerror="this.onerror=null;this.style.display='none'" />
            </div>
          )}
        </a>
      ))}
    </div>
  </section>

  <CtaBand lang={lang} waContext="model" waVars={{ model: m.model }} ctaKey1="cta.quote" ctaKey2="cta.waChat" />

  <Lightbox
    viewFull={pick('productPage.viewFull')}
    closeViewer={pick('productPage.closeViewer')}
    prevImg={pick('productPage.prevImg')}
    nextImg={pick('productPage.nextImg')}
  />
</Shell>
