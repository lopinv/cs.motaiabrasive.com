---
import { usePage, buildSeo } from '../../../lib/page.js'
import { langPaths } from '../../../lib/paths.js'
import Shell from '../../../components/Shell.astro'
import { breadcrumbJsonLd, faqJsonLd } from '../../../lib/tdk.js'
import SectionHeading from '../../../components/SectionHeading.astro'
import Prose from '../../../components/Prose.astro'
import CtaBand from '../../../components/CtaBand.astro'
import BlogSidebar from '../../../components/BlogSidebar.astro'
import YouTubeEmbed from '../../../components/YouTubeEmbed.astro'
import { findArticle, allSlugs, allArticles } from '../../../lib/articles.js'
import { sidebarProducts, defaultProducts, registerBodies } from '../../../lib/blog-products.js'
import { media, visibleVideos } from '../../../lib/utils.js'

// Route surface: the union of the md corpus and the i18n short articles,
// resolved per locale at build time.
export async function getStaticPaths() {
  const slugs = await allSlugs()
  return langPaths(slugs.map((slug) => ({ slug })))
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu } = usePage(lang)
const a = await findArticle(lang, ctx.slug)
const t = pick('article')
// The md corpus carries its own title/intro; the i18n short articles resolve
// through pick(). Both shapes expose .title/.intro by construction.
const title = a.title
const intro = a.intro
const isMd = a.source === 'md'

// Freshness byline: review date localized to the page language at build time.
// Use the 2-letter lang code (not ogLocale like `ar_SA`/`pt_PT`) — Node's
// small-icu rejects BCP47 region tags ("Invalid language tag"), but always
// accepts bare language codes. zh-Hant is a 4-letter route code: strip the
// -Hant/-HanS suffix so Intl gets the bare "zh" (long forms throw
// "Invalid language tag").
const reviewed = new Intl.DateTimeFormat(lang.replace(/-(Hant|HanS)$/, ''), { dateStyle: 'long' }).format(new Date(a.dateModified ?? a.datePublished))

// FAQ schema：仅对结构化短文（i18n 语料，faqPairs 由数据提供）产出，
// 避免从 md 长文正文正则切分问-答对（脆弱且多语种不可控）。
const faqPairs = (a.faqPairs ?? []).filter((x) => x?.q && x?.a)
const faqLd = faqPairs.length ? faqJsonLd(lang, faqPairs) : null

const seo = buildSeo(lang, 'article', { article: { title, intro, metaDescription: a.metaDescription, keywords: a.keywords, slug: a.slug, image: a.image, datePublished: a.datePublished, dateModified: a.dateModified } }, [
  breadcrumbJsonLd(lang, [
    { name: pick('nav.news'), path: `/${lang}/blog` },
    { name: title, path: `/${lang}/blog/${a.slug}` }
  ]),
  faqLd
].filter(Boolean))
const catKey = { 'selection-guide': 'catSelection', 'buyer-resources': 'catBuyer', 'application-notes': 'catNotes', 'oem-guide': 'catOem' }
// Article category → video product line, so each article shows a clip that
// covers the same product family.
const catVideoLine = { 'selection-guide': 'discs', 'buyer-resources': 'belts', 'application-notes': 'belts', 'oem-guide': 'oem' }
const relatedVideos = visibleVideos.filter((v) => v.line === catVideoLine[a.categoryKey]).slice(0, 1)

// Sidebar products: article-specific picks when the corpus links or names a
// product, otherwise the neutral family defaults. Never empty — the module is
// part of the page structure, not an optional extra.
// The i18n short articles carry their bodies in the translation table; register
// them so their in-text product links count the same as md-corpus links.
registerBodies(
  (a.sections ?? [])
    .filter((s) => s.bodyKey)
    .map((s) => [s.bodyKey, pick(s.bodyKey)])
)
const articleProducts = sidebarProducts(a)
const sideProducts = articleProducts.length ? articleProducts : defaultProducts()
// "Latest guides" excludes the article in view so the list always offers a
// next read.
const sideLatest = (await allArticles(lang)).filter((x) => x.slug !== a.slug).slice(0, 5)

// Long-form support: sections may carry a `subsections` array (H3) and each
// subsection may carry `h4` items (H4). Existing short articles (fixed
// start/compat/enquiry, no subsections) render exactly as before — the
// nested blocks simply render nothing when absent.
// Per-section anchor ids for the TOC; TOC only shows with >=3 H2 sections
// (5000-word long articles), so short 3-section pages still get one.
const secTitle = (s) => (s.source === 'md' ? s.title : pick(s.titleKey))
const secBody = (s) => (s.source === 'md' ? s.body : pick(s.bodyKey ?? ''))
const secId = (s) => String(secTitle(s) ?? s.key).trim().toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff\u3040-\u30ff\uac00-\ud7af]+/g, '-').replace(/^-+|-+$/g, '') || s.key
const toc = (a.sections ?? []).filter((s) => secTitle(s)).slice(0, 40)
// TOC is a long-form affordance: only show it when the article actually has
// deep structure (nested subsections, or >=5 top-level sections). The 6
// existing short articles (3 flat sections, no subsections) therefore render
// exactly as before — no TOC card, body markup unchanged.
const hasSubs = (a.sections ?? []).some((s) => (s.subsections ?? []).length)
const showToc = hasSubs || toc.length >= 5
---

<Shell lang={lang} seo={seo}>
  <div class="wrap breadcrumb"><a href={lu('/')}>Home</a><span>/</span><a href={lu('/blog')}>{pick('nav.news')}</a><span>/</span><span>{title}</span></div>

  <div class="section wrap blog-layout">
    <div class="blog-main">
      <span class="eyebrow">{pick(`article.${catKey[a.categoryKey]}`)}</span>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <p class="byline">
        <span>{pick('article.reviewedBy')}</span>
        <span aria-hidden="true">·</span>
        <span>{pick('article.lastReviewed').replace('{date}', reviewed)}</span>
      </p>
      <div class="prose">
        {(a.sections ?? []).map((s) => {
          const subs = s.subsections ?? []
          return (
            <section class={subs.length ? 'prose-sec prose-sec--nested' : 'prose-sec'} id={secId(s)}>
              <h2>{secTitle(s)}</h2>
              {secBody(s) && <Prose text={secBody(s)} lang={lang} />}
              {subs.map((u) => {
                const h4 = u.h4 ?? []
                return (
                  <section class="prose-sub">
                    <h3>{pick(u.titleKey)}</h3>
                    {u.bodyKey && pick(u.bodyKey) && <Prose text={pick(u.bodyKey)} lang={lang} />}
                    {h4.map((h) => (
                      <section class="prose-h4">
                        <h4>{pick(h.titleKey)}</h4>
                        {h.bodyKey && pick(h.bodyKey) && <Prose text={pick(h.bodyKey)} lang={lang} />}
                      </section>
                    ))}
                  </section>
                )
              })}
            </section>
          )
        })}
      </div>
    </div>

    <BlogSidebar
      lang={lang}
      products={sideProducts}
      latest={sideLatest}
      toc={showToc ? toc.map((s) => ({ id: secId(s), title: secTitle(s) })) : null}
    />
  </div>

  {relatedVideos.map((v) => (
    <section class="section wrap section--soft-tight">
      <div class="narrow">
        <SectionHeading title={t.watchTitle} />
        <YouTubeEmbed video={v} title={pick(v.titleKey)} description={pick(v.descriptionKey)} />
      </div>
    </section>
  ))}

  <CtaBand lang={lang} waContext="contact" ctaKey1="article.discuss" ctaKey2="cta.waChat" />
</Shell>
