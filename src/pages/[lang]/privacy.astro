---
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import { breadcrumbJsonLd } from '../../lib/tdk.js'
import SectionHeading from '../../components/SectionHeading.astro'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu } = usePage(lang)
const p = pick('privacy')
const seo = buildSeo(lang, 'privacy', {}, [
  breadcrumbJsonLd(lang, [{ name: p.h1, path: `/${lang}/privacy` }])
])
const sections = ['s1', 's2', 's3', 's4', 's5']
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: 'Home', href: '/' }, { name: p.h1 }]} />

  <section class="section wrap">
    <span class="eyebrow">PRIVACY POLICY</span>
    <h1>{p.h1}</h1>
    <p class="lead">{p.sub}</p>
  </section>

  <div class="section wrap section--flush-top">
    <div class="prose">
      {sections.map((s, i) => (
        <section>
          <h2>{i + 1}. {pick(`privacy.${s}t`)}</h2>
          <p>{pick(`privacy.${s}b`)}</p>
        </section>
      ))}
      <p class="small-note">{p.updated}</p>
    </div>
  </div>
</Shell>
