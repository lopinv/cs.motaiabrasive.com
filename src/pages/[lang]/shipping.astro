---
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import { breadcrumbJsonLd } from '../../lib/tdk.js'
import CtaBand from '../../components/CtaBand.astro'
import { products } from '../../lib/utils.js'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const { pick, lu } = usePage(lang)
const p = pick('shipping')
const seo = buildSeo(lang, 'shipping', {}, [
  breadcrumbJsonLd(lang, [{ name: p.h1, path: `/${lang}/shipping` }])
])
const shipSections = ['s1', 's2', 's3', 's4', 's5']
const retSections = ['r1', 'r2', 'r3', 'r4', 'r5']
// 包装规格表：按产品线汇总真实尺寸/粒度（数据来自 products.json，
// 用手头现成语料丰富页面，避免整页只有段落堆叠）
const packRows = [
  { labelKey: 'colt.belts.label', sizes: [...new Set(products.filter((x) => x.category === 'Abrasive Belts').flatMap((x) => x.sizes ?? []))], grits: [...new Set(products.filter((x) => x.category === 'Abrasive Belts').flatMap((x) => x.grits ?? []))].slice(0, 8) },
  { labelKey: 'colt.discs.label', sizes: [...new Set(products.filter((x) => x.category === 'Sanding Discs').flatMap((x) => x.sizes ?? []))], grits: [...new Set(products.filter((x) => x.category === 'Sanding Discs').flatMap((x) => x.grits ?? []))].slice(0, 8) }
].filter((r) => r.sizes.length > 0)
// 相关阅读出链（此页面包此前 0 出链，只进不出）
const relatedLinks = [
  { href: '/quote', label: pick('cta.quote') },
  { href: '/glossary', label: pick('nav.knowledge') },
  { href: '/blog', label: pick('nav.news') }
]
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: p.h1 }]} />

  <section class="section wrap">
    <span class="eyebrow">SHIPPING & RETURNS</span>
    <h1>{p.h1}</h1>
    <p class="lead">{p.sub}</p>
  </section>

  <div class="section wrap section--flush-top">
    <div class="prose">
      <section>
        <h2>{p.shipTitle}</h2>
        <p>{p.shipSub}</p>
      </section>
      {shipSections.map((s, i) => (
        <section class="prose-sec">
          <h3>{i + 1}. {pick(`shipping.${s}t`)}</h3>
          <p>{pick(`shipping.${s}b`)}</p>
        </section>
      ))}

      <!-- 包装规格表：把 s1-s5 里的规格信息表格化，机器可读 + 扫读友好 -->
      {packRows.length > 0 && (
        <section class="prose-sec">
          <h3>{pick('productPage.specTitle')}</h3>
          <table class="spec-table">
            <thead>
              <tr><th scope="col">{pick('colt.belts.label')}</th><th scope="col">{pick('meta.size')}</th><th scope="col">{pick('meta.grit')}</th></tr>
            </thead>
            <tbody>
              {packRows.map((r) => (
                <tr>
                  <th scope="row">{pick(r.labelKey)}</th>
                  <td>{r.sizes.join(' · ')}</td>
                  <td>{r.grits.join(' · ')}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="small-note">{p.s2t}</p>
        </section>
      )}

      <section>
        <h2>{p.retTitle}</h2>
        <p>{p.retSub}</p>
      </section>
      {retSections.map((s, i) => (
        <section class="prose-sec">
          <h3>{i + 1}. {pick(`shipping.${s}t`)}</h3>
          <p>{pick(`shipping.${s}b`)}</p>
        </section>
      ))}

      <section class="prose-sec">
        <h2>{p.related}</h2>
        <ul class="value-lines">
          {relatedLinks.map((l) => <li><a href={lu(l.href)}>{l.label} <span aria-hidden="true">→</span></a></li>)}
        </ul>
      </section>

      <p class="small-note">{p.updated} · {p.contact}</p>
    </div>
  </div>

  <CtaBand lang={lang} waContext="contact" ctaKey1="cta.quote" ctaKey2="cta.waChat" />
</Shell>