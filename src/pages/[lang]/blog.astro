---
/**
 * 博客索引页（全部文章，第 1 页）。分页规则见 src/lib/blog-pager.js：
 * 每页 24 篇，第 n 页落在 /blog/page/n/（见 [n].astro）。
 */
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import Breadcrumb from '../../components/Breadcrumb.astro'
import { breadcrumbJsonLd } from '../../lib/tdk.js'
import CtaBand from '../../components/CtaBand.astro'
import BlogIndex from '../../components/BlogIndex.astro'
import { allArticles } from '../../lib/articles.js'
import { defaultProducts } from '../../lib/blog-products.js'
import { BLOG_PAGE_SIZE, pagerInfo } from '../../lib/blog-pager.js'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const { pick, lu } = usePage(lang)
const t = pick('blogIndex')
const articles = await allArticles(lang)
const pager = pagerInfo(articles.length, 1)
const sideProducts = defaultProducts()

const seo = buildSeo(lang, 'blog', {}, [
  breadcrumbJsonLd(lang, [{ name: pick('nav.news'), path: `/${lang}/blog` }])
])
// 分类：按文章数降序，供筛选 chips 与卡片标签共用。
const CAT_KEYS = { 'selection-guide': 'catSelection', 'buyer-resources': 'catBuyer', 'application-notes': 'catNotes', 'oem-guide': 'catOem' }
const counts = {}
for (const a of articles) counts[a.categoryKey || 'selection-guide'] = (counts[a.categoryKey || 'selection-guide'] ?? 0) + 1
const categories = Object.entries(counts)
  .sort((a, b) => b[1] - a[1])
  .map(([key, count]) => ({ key, count, label: pick(`article.${CAT_KEYS[key]}`) ?? key }))
---

<Shell lang={lang} seo={seo}>
  <Breadcrumb lang={lang} trail={[{ name: pick('nav.news'), href: '/blog' }]} />

  <BlogIndex
    lang={lang}
    pageArticles={articles.slice(0, BLOG_PAGE_SIZE)}
    pager={{ ...pager, ...t, h1: t.h1, sub: t.sub, governance: t.governance, updatedLabel: t.updatedLabel, allLabel: pick('colt.all.label'), catsLabel: t.h1, sideProducts }}
    categories={categories}
    activeCategory=""
    canonicalPath="/blog"
    latest={articles.slice(0, 5)}
  />

  <CtaBand lang={lang} waContext="contact" ctaKey1="article.discuss" ctaKey2="cta.waChat" />
</Shell>
