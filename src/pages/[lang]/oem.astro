---
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import { breadcrumbJsonLd, faqJsonLd } from '../../lib/tdk.js'
import SectionHeading from '../../components/SectionHeading.astro'
import CtaBand from '../../components/CtaBand.astro'
import YouTubeEmbed from '../../components/YouTubeEmbed.astro'
import { videosData } from '../../lib/utils.js'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu, media, quoteUrl } = usePage(lang)
const o = pick('oem')
// FAQ pairs live under oem.o* / oem.oa* so faqJsonLd resolves the locale text.
const faqItems = ['o1', 'o2', 'o3', 'o4', 'o5'].map((k) => ({
  qKey: `oem.${k}`,
  aKey: `oem.oa${k.slice(1)}`,
  q: pick(`oem.${k}`),
  a: pick(`oem.oa${k.slice(1)}`)
})).filter((f) => f.q && f.a)
const checklist = [o.c1, o.c2, o.c3, o.c4, o.c5, o.c6].filter(Boolean)
const seo = buildSeo(lang, 'oem', {}, [
  breadcrumbJsonLd(lang, [{ name: pick('nav.oem'), path: `/${lang}/oem` }]),
  faqItems.length ? faqJsonLd(lang, faqItems) : null
])
const oemVideo = videosData.find((v) => v.line === 'oem')
---

<Shell lang={lang} seo={seo}>
  <div class="wrap breadcrumb"><a href={lu('/')}>Home</a><span>/</span><a href={lu('/oem')}>{pick('nav.oem')}</a></div>
  <section class="section wrap">
    <span class="eyebrow">OEM &amp; PRIVATE LABEL</span>
    <h1>{o.h1}</h1>
    <p class="lead">{o.sub}</p>
    <a class="button outline dark-outline mt-18" href={quoteUrl()} target="_blank" rel="noopener nofollow">{pick('cta.oemQuote')} <span aria-hidden="true">↗</span></a>
  </section>

  <section class="section wrap section--soft">
    <SectionHeading eyebrow={o.briefEyebrow} title={o.briefTitle} />
    <p class="body-narrow">{o.briefBody}</p>
  </section>

  <section class="section wrap">
    <SectionHeading title={o.itemsTitle} />
    <div class="grid grid-3">
      {['i1','i2','i3','i4','i5','i6'].map((k) => (
        <div class="value-card">
          <h3>{pick(`oem.${k}`)}</h3>
          <p>{o.itemNote}</p>
        </div>
      ))}
    </div>
  </section>

  {oemVideo && oemVideo.youtubeId && (
    <section class="section wrap section--soft-tight">
      <div class="narrow">
        <YouTubeEmbed video={oemVideo} title={pick(oemVideo.titleKey)} description={pick(oemVideo.descriptionKey)} />
      </div>
    </section>
  )}

  <section class="section wrap">
    <SectionHeading title={o.procTitle} />
    <div class="steps">
      {['pr1','pr2','pr3','pr4','pr5','pr6'].map((k, i) => (
        <div class="step"><b>0{i + 1}</b><div><h3>{pick(`oem.${k}t`)}</h3><p>{pick(`oem.${k}b`)}</p></div></div>
      ))}
    </div>
  </section>

  <section class="section wrap section--soft">
    <SectionHeading eyebrow="BRIEF" title={o.checklistTitle} sub={o.specSub} />
    <div class="value-card">
      <ul class="value-lines">
        {checklist.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  {faqItems.length > 0 && (
    <section class="section wrap">
      <SectionHeading title={o.faqTitle} sub={o.faqSub} />
      <div class="faq-list">
        {faqItems.map((f) => (
          <div class="faq-item">
            <h3 class="faq-q">{f.q}</h3>
            <p class="faq-a">{f.a}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <CtaBand lang={lang} waContext="oem" ctaKey1="oem.cta1" ctaKey2="oem.cta2" />
</Shell>
