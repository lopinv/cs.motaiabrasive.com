---
import { usePage, buildSeo } from '../../lib/page.js'
import { langPaths } from '../../lib/paths.js'
import Shell from '../../components/Shell.astro'
import { breadcrumbJsonLd } from '../../lib/tdk.js'
import SectionHeading from '../../components/SectionHeading.astro'

export function getStaticPaths() {
  return langPaths()
}

const { lang } = Astro.params
const ctx = Astro.params
const { pick, lu, wa, quoteUrlRaw } = usePage(lang)
const q = pick('quotePage')
const seo = buildSeo(lang, 'quote', {}, [
  breadcrumbJsonLd(lang, [{ name: q.h1, path: `/${lang}/quote` }])
])
const go = quoteUrlRaw({})
---

<Shell lang={lang} seo={seo}>
  <div class="wrap breadcrumb"><a href={lu('/')}>Home</a><span>/</span><span>{q.h1}</span></div>

  <section class="section wrap">
    <span class="eyebrow">WHOLESALE / OEM ENQUIRY</span>
    <h1>{q.h1}</h1>
    <p class="lead">{q.sub}</p>
    <p class="small-note mt-12">{q.note}</p>
  </section>

  <section class="section wrap section--soft-tight">
    <div class="grid grid-2">
      <div class="value-card">
        <span class="vno">01</span>
        <h3>{q.sec1}</h3>
        <p class="value-lines">{q.f1}<br />{q.f2}<br />{q.f3}<br />{q.f4}<br />{q.f5}<br />{q.f6}: {q.opt1} / {q.opt2} / {q.opt3} / {q.opt4} / {q.opt5} / {q.opt6}</p>
      </div>
      <div class="value-card">
        <span class="vno">02</span>
        <h3>{q.sec2}</h3>
        <p class="value-lines">{q.f7}<br />{q.f8}<br />{q.f9}<br />{q.f10}<br />{q.f11}<br />{q.f12}<br />{q.f13}<br />{q.f14}<br />{q.f15}<br />{q.f16}</p>
        <p class="small-note">{q.consent}</p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <p class="cta-note">{q.goNote}</p>
    <div class="cta-band-actions cta-band-actions--auto">
      <a class="button" href={go} target="_blank" rel="noopener nofollow">{q.btn1} <span aria-hidden="true">↗</span></a>
      <a class="button outline dark-outline" href={wa('contact')} target="_blank" rel="noopener nofollow">{q.btn2}</a>
    </div>
  </section>
</Shell>
