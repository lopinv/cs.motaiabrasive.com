---
import { defaultLang } from '../lib/i18n.js'
import { TRANSLATIONS } from '../lib/i18n.js'
import Shell from '../components/Shell.astro'
import { buildSeo } from '../lib/page.js'
import { localizedUrl } from '../lib/utils.js'

const lang = defaultLang()
const tr = TRANSLATIONS[lang]
const base = buildSeo(lang, 'home')
const seo = { ...base, title: '404 — Page not found', description: `${tr.meta.siteName} — page not found`, canonicalPath: '', jsonld: [] }
---

<Shell lang={lang} seo={seo}>
  <section class="section wrap page-404">
    <span class="eyebrow">404</span>
    <h1>Page not found</h1>
    <p>
      The page you were looking for does not exist in this language. The default language home is at {localizedUrl(lang, '')}.
    </p>
    <a class="button" href={localizedUrl(lang, '')}>{tr.nav.home}</a>
  </section>
</Shell>
