---
/**
 * FAQ 手风琴：问题行常驻可点、答案默认收起，点击展开。
 *
 * - 用原生 <details>/<summary>：无 JS 也能展开/收起（零依赖、可访问性由浏览器保证）
 * - 完整保留 .faq-list / .faq-item / .faq-q / .faq-a class ——
 *   产品页/询价页/视频页等沿用这些 class 的样式，构建门禁亦不受影响
 * - <p class="faq-a"> 的答案文本始终在 DOM 中（即使收起），
 *   因此 FAQPage JSON-LD 与可见文本仍一致，SEO/AEO 无损
 * - products 页 8-9 条全展开会把首屏顶掉：默认只展开第一条
 */
const { items, openFirst = true, twoCol = false } = Astro.props
---

<div class:list={['faq-list', { 'faq-list--2col': twoCol }]}>
  {items.map((item, i) => (
    <details class="faq-item" open={openFirst && i === 0}>
      <summary class="faq-q">
        {item.q}
        <span class="faq-chevron" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
        </span>
      </summary>
      <p class="faq-a">{item.a}</p>
    </details>
  ))}
</div>

<style>
  <!-- summary 承揽原 .faq-q 视觉：问题行常驻 + 右侧箭头指示可展开 -->
  .faq-item > summary.faq-q {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--sp-3);
    cursor: pointer; list-style: none;
    font-size: 15px; line-height: 1.45;
    margin: 0;
  }
  .faq-item > summary.faq-q::-webkit-details-marker { display: none; }
  .faq-item > summary.faq-q::marker { content: ''; }
  .faq-chevron {
    flex: 0 0 auto; width: 18px; height: 18px;
    display: grid; place-items: center;
    color: var(--muted);
    transition: transform var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .faq-chevron svg { width: 100%; height: 100%; }
  .faq-item[open] > summary.faq-q .faq-chevron { transform: rotate(180deg); color: var(--accent); }
  .faq-item > summary.faq-q:hover .faq-chevron { color: var(--accent); }
  <!-- 答案与问题行之间留出间距（原 static 版靠 h3 的 margin-bottom） -->
  .faq-item > .faq-a { margin: var(--sp-2) 0 0; font-size: 14.5px; }
  <!-- 键盘焦点：整行问题可见焦点环 -->
  .faq-item > summary.faq-q:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 2px; border-radius: var(--r-sm);
  }
</style>