---
/**
 * 博客列表页分页器：上一页 / 页码 / 下一页 + 「第 x–y 篇，共 n 篇」摘要。
 *
 * 纯静态、零 JS：所有链接都是真实 URL。URL 规则由调用方传入 base：
 *   base = '/blog'           →  第 1 页 /blog/，第 n 页 /blog/page/n/
 *   base = '/blog/category/x' →  同规则
 * 当前页用 aria-current="page" 标记（无障碍 + 搜索引擎可读）。
 */
import { localizedUrl } from '../lib/utils.js'
import { TRANSLATIONS } from '../lib/i18n.js'

const { lang, pager, page, pages, base } = Astro.props
const tr = TRANSLATIONS[lang]
const t = tr.blogPager ?? {}
const u = (p) => localizedUrl(lang, p)
/** 分页路由：第 1 页不生成 page 段（/blog/ 自身），其余 /blog/page/n/。 */
const pageUrl = (n) => (n === 1 ? u(base) : u(`${base}/page/${n}`))
const fill = (s, vars) => String(s ?? '').replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? '')
/** 页码窗口：当前页 ±2，首尾始终可见（如 1 … 3 4 5 6 7 … 10）。 */
const window = []
if (pages <= 7) for (let n = 1; n <= pages; n++) window.push(n)
else {
  const lo = Math.max(2, page - 2)
  const hi = Math.min(pages - 1, page + 2)
  window.push(1)
  if (lo > 2) window.push('gap-lo')
  for (let n = lo; n <= hi; n++) window.push(n)
  if (hi < pages - 1) window.push('gap-hi')
  window.push(pages)
}
---

{pages > 1 && (
  <nav class="blog-pager" aria-label={t.navLabel}>
    <p class="blog-pager-range">{fill(t.range, { from: pager.from, to: pager.to, count: pager.total })}</p>
    <ol class="blog-pager-list">
      {page > 1 && (
        <li>
          <a class="pager-nav" href={pageUrl(page - 1)} rel="prev">
            <span aria-hidden="true">←</span> {t.prev}
          </a>
        </li>
      )}
      {window.map((n) => (
        <li>
          {typeof n === 'number'
            ? <a class:list={['pager-num', { 'is-current': n === page }]} href={pageUrl(n)} aria-current={n === page ? 'page' : undefined}>{n}</a>
            : <span class="pager-gap" aria-hidden="true">…</span>}
        </li>
      ))}
      {page < pages && (
        <li>
          <a class="pager-nav" href={pageUrl(page + 1)} rel="next">
            {t.next} <span aria-hidden="true">→</span>
          </a>
        </li>
      )}
    </ol>
    <p class="blog-pager-of">{fill(t.pageOf, { page, total: pages })}</p>
  </nav>
)}
