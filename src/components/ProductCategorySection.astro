---
/**
 * 首页产品分类区块：按产品线分区展示，每区 = 左文案 + 右真实产品图 + 双 CTA。
 *
 * 对齐原站首页的分区结构（Abrasive Belts → Flap Discs → Sanding Sponges）：
 *   - 每区有独立的 eyebrow / 标题 / 说明
 *   - 右侧真实产品实拍（砂带型号图、百叶片图、海绵系列图、砂盘图）
 *   - 底部「Explore 分类」+「Request a Quote」双 CTA
 *
 * 砂带区额外列出 4 个尺寸链接（原站规格表结构），其余区带图集缩略。
 */
import { TRANSLATIONS } from '../lib/i18n.js'
import { quoteUrl, localizedUrl } from '../lib/utils.js'
import homeData from '../data/home.json'

const { lang } = Astro.props
const tr = TRANSLATIONS[lang]
const pick = (p) => p.split('.').reduce((c, k) => (c ? c[k] : undefined), tr)
const categories = homeData.categories
const beltSizes = [
  { label: '533 × 75 mm', href: '/products/533x75-abrasive-belt' },
  { label: '610 × 100 mm', href: '/products/610x100-abrasive-belt' },
  { label: '1520 × 630 mm', href: '/products/1520x630-abrasive-belt' },
  { label: '2200 × 1330 mm', href: '/products/2200x1330-abrasive-belt' }
]
---

<section class="section wrap section--cat" id="product-categories">
  <div class="section-head section-head--row">
    <div>
      <span class="eyebrow">{pick('nav.products')}</span>
      <h2>{pick('home.catSectionTitle')}</h2>
      <p class="section-head-sub">{pick('home.catSectionSub')}</p>
    </div>
    <a class="button outline dark-outline" href={localizedUrl(lang, '/collections/all')}>
      {pick('colt.all.title')} <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="cat-list">
    {categories.map((cat, ci) => (
      <article class:list={['cat-block', { 'cat-block--flip': ci % 2 === 1 }]}>
        <div class="cat-copy">
          <span class="eyebrow">{pick(cat.labelKey)}</span>
          <h3>{pick(cat.titleKey)}</h3>
          <p class="cat-desc">{pick(cat.descKey)}</p>

          {cat.key === 'belts' && (
            <ul class="cat-sizes">
              {beltSizes.map((s) => (
                <li><a href={localizedUrl(lang, s.href)}>{s.label} <span aria-hidden="true">↗</span></a></li>
              ))}
            </ul>
          )}

          {cat.items && (
            <ul class="cat-links">
              {cat.items.map((it) => (
                <li><a href={localizedUrl(lang, it.href)}>{pick(it.titleKey)} <span aria-hidden="true">→</span></a></li>
              ))}
            </ul>
          )}

          {cat.gallery && (
            <ul class="cat-thumbs">
              {cat.gallery.map((g, gi) => (
                <li><img src={g} alt="" loading="lazy" width="120" height="120" onerror="this.remove()" /></li>
              ))}
            </ul>
          )}

          <div class="cat-actions">
            <a class="button" href={localizedUrl(lang, cat.href)}>
              {pick(cat.labelKey)} <span aria-hidden="true">↗</span>
            </a>
            <a class="button outline dark-outline" href={quoteUrl()} target="_blank" rel="noopener nofollow">
              {pick('cta.quote')}
            </a>
          </div>
        </div>
        <div class="cat-media">
          <img
            src={cat.image}
            alt={pick(cat.labelKey)}
            loading="lazy"
            decoding="async"
            onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-fallback')"
          />
        </div>
      </article>
    ))}
  </div>
</section>
