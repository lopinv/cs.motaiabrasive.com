---
/**
 * 首页产品分类区块：按产品线展示，每线一张「上图下文」分类卡片。
 *
 * 视觉与「Pick the application」场景卡片（scene-card）刻意对齐，让首页两处
 * 网格读起来像同一套设计系统：
 *   - 多列卡片网格，每卡 = 上方实拍图 + 下方文案区
 *   - 同一套边框 / 圆角 / hover 抬升 / 图片轻推近的动效语言
 *
 * 卡片结构保持最小：完整显示的产品图（contain 不裁切）+ 分类标签 + 标题
 * + 一句说明 + 双 CTA（WhatsApp / Request a quote，固定同行）。
 * 旧的砂带尺寸链接、分类子列表与图集缩略已按产品决策移除。
 */
import { TRANSLATIONS } from '../lib/i18n.js'
import { quoteUrl, waLink, localizedUrl } from '../lib/utils.js'
import homeData from '../data/home.json'

const { lang } = Astro.props
const tr = TRANSLATIONS[lang]
const pick = (p) => p.split('.').reduce((c, k) => (c ? c[k] : undefined), tr)
const categories = homeData.categories
/**
 * 卡片标题取 colt.*.title 的第一段：各语种的 SEO 长标题都带
 * 「— 批发与 OEM」类后缀（77 个语种×分类组合，形态各异无法统一剥），
 * 按分隔符（— – · | :）切分取首段，得到干净的产品线名。
 * 无分隔符时原样返回（如 en 的 "Sanding Sponges"；各语种带品牌前缀的
 * 标题同理原样保留）。
 */
const shortTitle = (key) => {
  const raw = pick(key) ?? ''
  return raw.split(/\s*[—–·|:]\s*/)[0].trim() || raw
}
---

<section class="section wrap section--cat" id="product-categories">
  <div class="section-head section-head--row">
    <div>
      <span class="eyebrow">{pick('nav.products')}</span>
      <h2>{pick('home.catSectionTitle')}</h2>
      <p class="section-head-sub">{pick('home.catSectionSub')}</p>
    </div>
    <a class="button outline dark-outline" href={localizedUrl(lang, '/collections/all')}>
      {pick('colt.all.title')} <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="cat-grid">
    {categories.map((cat, i) => (
      <article class="cat-card">
        <a class="cat-card-media" href={localizedUrl(lang, cat.href)} aria-label={pick(cat.labelKey)}>
          <img
            src={cat.image}
            alt={pick(cat.labelKey)}
            loading="lazy"
            decoding="async"
            onerror="this.onerror=null;this.style.display='none';this.parentElement.classList.add('img-fallback')"
           width="1200" height="750"/>
        </a>
        <div class="cat-card-body">
          <!-- eyebrow 用两位序号（01–04）建立编号节奏；分类名由 h3 承担，
               避免 eyebrow 与标题重复同一串文字 -->
          <span class="eyebrow cat-no">{String(i + 1).padStart(2, '0')}</span>
          <!-- 卡片标题用 titleKey 首段（剥掉各语种的「— 批发与 OEM」类后缀）；
                eyebrow 显示分类标签，两者不再重复 -->
          <h3>{shortTitle(cat.titleKey)}</h3>
          <p class="cat-desc">{pick(cat.descKey)}</p>

          <!-- 双 CTA 固定同行：WhatsApp + Request a quote（沿用吸底条的短标签，4 列
     卡片下两个按钮才能稳定同排；长标签用 cta.waChat / cta.quote 会换行） -->
          <div class="cat-actions">
            <a class="button outline dark-outline small" href={waLink(lang, 'generic')} target="_blank" rel="noopener nofollow">
              {pick('quickBar.whatsapp')}
            </a>
            <a class="button small" href={quoteUrl()} target="_blank" rel="noopener nofollow">
              {pick('quickBar.quote')} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
