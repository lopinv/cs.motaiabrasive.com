---
import { TRANSLATIONS, LANGS } from '../lib/i18n.js'
import { site, quoteUrl, localizedUrl } from '../lib/utils.js'
const { lang, routePath = '' } = Astro.props
const tr = TRANSLATIONS[lang]
// Brand name is localized: 简体/繁體中文 render 墨泰磨料 instead of MoTai.
const brand = tr.brand?.brand ?? site.brand
const brandSub = tr.brand?.sub ?? 'ABRASIVES'
// Order: Home → About → Manufacturing → OEM services → Products → Contact →
// Videos → Knowledge → News. The Products dropdown is rendered inline at its
// position, so it stays grouped in the same array.
const navItems = [
  { key: 'nav.home', href: `/`, type: 'link' },
  { key: 'nav.about', href: `/about`, type: 'link' },
  { key: 'nav.manufacturing', href: `/factory`, type: 'link' },
  { key: 'nav.oem', href: `/oem`, type: 'link' },
  { key: 'nav.products', href: `/collections/all`, type: 'products' },
  { key: 'nav.contact', href: `/contact`, type: 'link' },
  { key: 'nav.videos', href: `/videos`, type: 'link' },
  { key: 'nav.knowledge', href: `/glossary`, type: 'link' },
  { key: 'nav.news', href: `/blog`, type: 'link' }
]
const products = [
  { key: 'colt.belts', href: '/collections/abrasive-belts' },
  { key: 'colt.discs', href: '/collections/sanding-discs' },
  { key: 'colt.flap', href: '/collections/flap-discs' },
  { key: 'colt.sponge', href: '/collections/sanding-sponges' }
]
function trKey(key) {
  return key.split('.').reduce((c, k) => (c ? c[k] : undefined), tr)
}
const l = {
  ...tr.nav,
  ...Object.fromEntries(products.map((p) => [p.key, tr.colt[p.key.replace('colt.', '')].label]))
}
// Language-switcher targets: same route, other locale (keeps the user on
// the equivalent page, matching hreflang semantics). Home route ('') -> /.
const langOpts = LANGS.map((code) => ({
  code,
  codeLabel: TRANSLATIONS[code].codeLabel,
  name: TRANSLATIONS[code].name,
  href: localizedUrl(code, routePath),
  selected: code === lang
}))
---

<div class="motai-contact-bar">
  <div class="motai-contact-inner">
    <div class="motai-contact-left">
      <a href={site.whatsapp} rel="noopener nofollow" target="_blank">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
        <span>{site.phone}</span>
      </a>
      <a href={`mailto:${site.email}`}><span>{site.email}</span></a>
    </div>
    <details class="lang-switch" aria-label="Language sub-site switcher">
      <summary class="lang-trigger">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.2"/><path d="M2.8 12h18.4M12 2.8c2.5 2.6 3.8 5.7 3.8 9.2s-1.3 6.6-3.8 9.2M12 2.8C9.5 5.4 8.2 8.5 8.2 12s1.3 6.6 3.8 9.2"/></svg>
        <span class="lang-current">{tr.nav.language} · {TRANSLATIONS[lang].codeLabel}</span>
      </summary>
      <div class="lang-panel" onclick="this.parentElement.open=false" role="menu">
        <div class="lang-panel-heading">{tr.nav.language}</div>
        <div class="lang-options">
          {langOpts.map((o) => (
            <a class={`lang-option ${o.selected ? 'selected' : ''}`} href={o.href}>
              <span class="lang-code">{o.codeLabel}</span>
              <span>{o.name}</span>
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</div>

<header class="header motai-header">
  <div class="wrap motai-nav-row">
    <a class="brand" href={localizedUrl(lang, '/')}>
      <img alt={`${brand} original logo`} src={site.logo} loading="eager" onerror="this.style.display='none'" />
      <span>{brand}<span class="brand-sub">{brandSub}</span></span>
    </a>
    <nav class="motai-main-nav" aria-label="Main navigation">
      {navItems.map((item) =>
        item.type === 'products' ? (
          <div class="motai-nav-group">
            <a href={localizedUrl(lang, item.href)}>{trKey(item.key)}</a>
            <div class="motai-nav-dropdown">
              {products.map((p) => (
                <a href={localizedUrl(lang, p.href)}>{tr.colt[p.key.replace('colt.', '')].label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a href={localizedUrl(lang, item.href === '/' ? '' : item.href)}>
            {trKey(item.key)}
          </a>
        )
      )}
    </nav>
    <details class="mobile-menu" aria-label="Mobile menu">
      <summary class="menu-toggle" aria-label="Toggle menu">
        <span></span><span></span><span></span>
      </summary>
      <div class="mobile-menu-panel">
        <nav class="mobile-nav">
          {navItems.map((item) =>
            item.type === 'products' ? (
              <>
                <a href={localizedUrl(lang, item.href)}>{trKey(item.key)}</a>
                <div class="sub-label">{tr.nav.products}</div>
                {products.map((p) => (
                  <a class="sub-link" href={localizedUrl(lang, p.href)}>{tr.colt[p.key.replace('colt.', '')].label}</a>
                ))}
                <a class="sub-link" href={localizedUrl(lang, '/collections/all')}>{tr.colt.all.title}</a>
              </>
            ) : (
              <a href={localizedUrl(lang, item.href === '/' ? '' : item.href)}>{trKey(item.key)}</a>
            )
          )}
        </nav>
        <div class="lang-mobile">
          <div class="sub-label">{tr.nav.language}</div>
          <div class="lang-mobile-grid">
            {langOpts.map((o) => (
              <a class={`lang-chip ${o.selected ? 'selected' : ''}`} href={o.href}>
                <span class="lang-code">{o.codeLabel}</span>
                <span>{o.name}</span>
              </a>
            ))}
          </div>
        </div>
        <div class="motai-nav-actions">
          <a class="motai-feedback" href={quoteUrl()} target="_blank" rel="noopener nofollow">{tr.cta.quote}</a>
        </div>
      </div>
    </details>
    <div class="motai-nav-actions">
      <a class="motai-feedback" href={quoteUrl()} target="_blank" rel="noopener nofollow">{tr.cta.quote}</a>
    </div>
  </div>
</header>
