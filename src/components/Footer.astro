---
import { TRANSLATIONS } from '../lib/i18n.js'
import { site, localizedUrl, media } from '../lib/utils.js'
const { lang } = Astro.props
const tr = TRANSLATIONS[lang]
const f = tr.footer
const productLinks = [
  { key: 'belts', href: '/collections/abrasive-belts' },
  { key: 'discs', href: '/collections/sanding-discs' },
  { key: 'flap', href: '/collections/flap-discs' }
]
const exploreLinks = [
  { key: 'aboutUs', href: '/about', labelKey: 'footer.aboutUs' },
  { key: 'mfgQ', href: '/factory', labelKey: 'footer.mfgQ' },
  { key: 'oemPl', href: '/oem', labelKey: 'footer.oemPl' },
  { key: 'newsB', href: '/blog', labelKey: 'footer.newsB' }
]
---

<footer class="footer">
  <div class="wrap footer-grid">
    <div>
      <a class="brand" href={localizedUrl(lang, '')}>
        <img alt="MoTai original logo" src={site.logo} loading="lazy" onerror="this.style.display='none'" />
        <span>MoTai<span class="brand-sub">ABRASIVES</span></span>
      </a>
      <p>{tr.footer.blurb}</p>
      <div class="socials">
        <a class="social-link" href={site.facebook} aria-label="Facebook" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.245 2.686.245v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span>Facebook</span>
        </a>
        <a class="social-link" href={site.instagram} aria-label="Instagram" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C8.74 0 8.333.015 7.053.072 5.775.132 4.995.333 4.17.63c-.78.304-1.44.67-2.11 1.36-.69.69-1.06 1.35-1.355 2.13C.333 5.025.132 5.775.072 7.072.015 8.333 0 8.74 0 12s.015 3.667.072 4.927c.06 1.297.262 2.048.558 2.828.304.78.67 1.44 1.36 2.11.69.69 1.35 1.06 2.13 1.355.78.304 1.53.505 2.827.565C8.333 23.985 8.74 24 12 24s3.667-.015 4.927-.072c1.297-.06 2.048-.262 2.828-.558.78-.304 1.44-.67 2.11-1.36.69-.69 1.06-1.35 1.355-2.13.304-.78.505-1.53.565-2.828C23.985 15.667 24 15.26 24 12s-.015-3.667-.072-4.927c-.06-1.297-.262-2.048-.558-2.828C23.033 3.425 22.667 2.765 21.977 2.095 21.286 1.405 20.625 1.04 19.845.745c-.78-.304-1.53-.505-2.828-.565C15.667.015 15.26 0 12 0zm0 2.16c3.203 0 3.586.014 4.85.071 1.16.054 1.805.249 2.227.412.562.216.96.477 1.383.9.423.422.684.82.9 1.382.162.423.36 1.068.413 2.227.057 1.265.07 1.648.07 4.85s-.015 3.585-.07 4.85c-.054 1.16-.249 1.805-.412 2.227-.216.562-.478.96-.9 1.383-.423.423-.82.684-1.383.9-.423.163-1.068.36-2.227.413-1.265.057-1.647.07-4.85.07-3.203 0-3.586-.015-4.85-.07-1.16-.054-1.805-.25-2.227-.412-.562-.217-.96-.478-1.383-.9-.423-.423-.684-.82-.9-1.383-.163-.422-.36-1.067-.413-2.227-.057-1.265-.07-1.647-.07-4.85s.014-3.586.07-4.85c.054-1.16.25-1.805.412-2.227.217-.562.478-.96.9-1.383.423-.422.82-.684 1.383-.9.422-.162 1.067-.36 2.227-.413 1.265-.057 1.647-.07 4.85-.07zM12 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          <span>Instagram</span>
        </a>
        <a class="social-link" href={site.whatsapp} aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.944 1.164-.177.199-.35.224-.647.075-.297-.149-1.255-.463-2.39-1.475-.883-.786-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.351.446-.524.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.611-.916-2.206-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.05 1.004-1.05 2.459 0 1.454 1.05 2.859 1.199 3.058.149.198 2.096 3.206 5.124 4.455.716.295.96.405 1.235.45.35.066.96.193 1.441.05.579-.16.973-.594 1.18-.966.207-.375.295-.86.295-.944.008-.084.066-.52-.09-.941-.153-.42-.669-.669-1.055-.869m-5.194 9.198h-.004a9.876 9.876 0 01-5.031-1.368l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.002-5.45 4.437-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.826 9.826 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.28.18C5.75.18.468 5.466.468 11.995c0 2.098.547 4.142 1.588 5.945L.53 26.04l8.217-2.153c1.733.952 3.695 1.448 5.683 1.45h.003c6.53 0 11.815-5.287 11.815-11.817 0-3.16-1.233-6.125-3.47-8.361z"/></svg>
          <span>WhatsApp</span>
        </a>
      </div>
    </div>
    <div>
      <h3>{f.products}</h3>
      {productLinks.map((p) => <a href={localizedUrl(lang, p.href)}>{tr.colt[p.key].title}</a>)}
      <a href={localizedUrl(lang, '/collections/all')}>{tr.colt.all.title}</a>
      <a href={localizedUrl(lang, '/quote')}>{tr.cta.quote}</a>
    </div>
    <div>
      <h3>{f.explore}</h3>
      {exploreLinks.map((e) => <a href={localizedUrl(lang, e.href)}>{f[e.labelKey.replace('footer.', '')]}</a>)}
    </div>
    <div>
      <h3>{f.connect}</h3>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.whatsapp} rel="noopener noreferrer" target="_blank">{site.phoneDisplay}</a>
      <p>{site.company}<br />{site.addressShort}</p>
      <a href={localizedUrl(lang, '/contact')}>{f.contactUs}</a>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>{site.copyright}</span>
    <div><a href={localizedUrl(lang, '/privacy')}>{f.privacy}</a> · <a href={localizedUrl(lang, '/terms')}>{f.terms}</a></div>
  </div>
</footer>
