---
/**
 * Right-side floating rail: WhatsApp chat trigger + quote + email + back-to-top.
 * Progressive enhancement (works with JS disabled):
 *   - back-to-top is an <a href="#top"> — native anchor jump still works
 *     (smoothed by html{scroll-behavior:smooth}); the intercepting script
 *     prevents the URL mutation and smooth-scrolls via scrollTo() instead.
 *   - the WA trigger is a real <a href=wa.me> — without JS it opens the
 *     pre-filled WhatsApp conversation as before; with JS the click toggles
 *     the in-page chat window instead, and "Send" re-opens wa.me with the
 *     typed message (the only chat a static site can offer — no server).
 * The intercepting script is emitted verbatim via set:html (same pattern as
 * GoogleAnalytics — is:inline bodies are not interpolated by Astro).
 */
import { TRANSLATIONS } from '../lib/i18n.js'
import { site, waLink, localizedUrl } from '../lib/utils.js'
const { lang, context = 'generic' } = Astro.props
const tr = TRANSLATIONS[lang]
const t = tr.floatChat ?? TRANSLATIONS.en.floatChat
const sendUrl = waLink(lang, context)

const script =
  `;(function () {\n` +
  `  function init() {\n` +
  `    var rail = document.querySelector('.floating');\n` +
  `    if (!rail) return;\n` +
  `    // 1) back-to-top: intercept the anchor; smooth-scroll, URL stays clean.\n` +
  `    var top = rail.querySelector('.back-to-top');\n` +
  `    if (top) top.addEventListener('click', function (e) {\n` +
  `      e.preventDefault();\n` +
  `      window.scrollTo({ top: 0, behavior: 'smooth' });\n` +
  `    }, false);\n` +
  `    // 2) WhatsApp chat window: toggle open/close, Send routes to wa.me.\n` +
  `    var trigger = rail.querySelector('.wa-trigger');\n` +
  `    var win = rail.querySelector('.wa-window');\n` +
  `    if (trigger && win) {\n` +
  `      var closeBtn = win.querySelector('.wa-close');\n` +
  `      var form = win.querySelector('.wa-form');\n` +
  `      var input = win.querySelector('.wa-input');\n` +
  `      var base = trigger.getAttribute('href') || '';\n` +
  `      var bare = base.split('?')[0];\n` +
  `      function setOpen(v) {\n` +
  `        win.open = v;\n` +
  `        trigger.setAttribute('aria-expanded', v ? 'true' : 'false');\n` +
  `        if (v && input) input.focus({ preventScroll: true });\n` +
  `      }\n` +
  `      trigger.addEventListener('click', function (e) {\n` +
  `        e.preventDefault();\n` +
  `        e.stopPropagation();\n` +
  `        setOpen(!win.open);\n` +
  `      }, false);\n` +
  `      if (closeBtn) closeBtn.addEventListener('click', function () {\n` +
  `        setOpen(false);\n` +
  `        trigger.focus({ preventScroll: true });\n` +
  `      }, false);\n` +
  `      document.addEventListener('keydown', function (e) {\n` +
  `        if (e.key === 'Escape' && win.open) setOpen(false);\n` +
  `      }, false);\n` +
  `      if (form) form.addEventListener('submit', function (e) {\n` +
  `        e.preventDefault();\n` +
  `        var msg = input ? input.value.trim() : '';\n` +
  `        var url = msg ? bare + '?text=' + encodeURIComponent(msg) : base;\n` +
  `        window.open(url, '_blank', 'noopener');\n` +
  `        if (typeof window.gtag === 'function') {\n` +
  `          window.gtag('event', 'whatsapp_click', { link_url: url, has_message: !!msg, source: 'chat-window' });\n` +
  `        }\n` +
  `        if (input) input.value = '';\n` +
  `        setOpen(false);\n` +
  `      }, false);\n` +
  `    }\n` +
  `  }\n` +
  `  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, false);\n` +
  `  else init();\n` +
  `})();\n`
---

<aside aria-label="Quick contact" class="floating">
  <a class="wa-trigger" aria-label={t.open} aria-expanded="false" aria-controls="motai-wa-window" href={sendUrl} rel="noopener nofollow" target="_blank" title={t.open}>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
  </a>
  <a aria-label={tr.cta.quote} href={localizedUrl(lang, '/quote')} title={tr.cta.quote}>
    <svg aria-hidden="true" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
  </a>
  <a aria-label="Email" href={`mailto:${site.email}`} title="Email">
    <svg aria-hidden="true" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect height="16" rx="2" width="20" x="2" y="4"/></svg>
  </a>
  <a class="back-to-top" aria-label="Back to top" href="#top" title="Back to top">
    <svg aria-hidden="true" fill="none" height="24" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg>
  </a>
  <details class="wa-window" id="motai-wa-window">
    <summary aria-hidden="true" tabindex="-1"></summary>
    <div class="wa-panel">
      <header class="wa-head">
        <span class="wa-dot" aria-hidden="true"></span>
        <div>
          <strong>{t.title}</strong>
          <span class="wa-status">{t.status}</span>
        </div>
        <button class="wa-close" type="button" aria-label={t.close}>✕</button>
      </header>
      <div class="wa-body">
        <p class="wa-greet">{t.greeting}</p>
      </div>
      <form class="wa-form">
        <input class="wa-input" type="text" placeholder={t.placeholder} autocomplete="off" />
        <button class="wa-send" type="submit" aria-label={t.send} title={t.send}>
          <svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M14.536 21.686a.5.5 0 0 0 .935-.481V2.795a.5.5 0 0 0-.75-.431L2.5 9.914a1.2 1.2 0 0 0 0 2.172Z"/><path d="M14.5 14 21.5 21.5"/></svg>
        </button>
      </form>
      <p class="wa-note">{t.note}</p>
    </div>
  </details>
</aside>

<script is:inline set:html={script} />
