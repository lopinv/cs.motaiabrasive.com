---
/**
 * 应用场景轮播：真实工艺实拍图横向滚动，带左右箭头与实时页码计数。
 *
 * 对齐原站「Built for your next finish.」区块：实拍工艺图 + 前后翻页 + 页码计数。
 * 无 JS 时退化为可横向滚动的网格（CSS scroll-snap），移动端原生手势可用。
 *
 * 实现要点（脚本查询根必须是整个 <section>）：
 *   - 箭头按钮渲染在 section 头的右侧，轨道在下方，二者同为 section 子级；
 *     旧实现用 `[data-scene-track]`（= .scene-root）作查询根，箭头不在其内，
 *     querySelector 返回 null 导致点击监听从未绑定——这是按钮"失效"的根因。
 *   - 计数显示真实页码（当前页–总页数），由滚动位置算出，非常量。
 */
import { TRANSLATIONS } from '../lib/i18n.js'
import { localizedUrl } from '../lib/utils.js'
import homeData from '../data/home.json'

const { lang } = Astro.props
const tr = TRANSLATIONS[lang]
const h = tr.home
const pick = (p) => p.split('.').reduce((c, k) => (c ? c[k] : undefined), tr)
const scenes = homeData.scenes
// 复用既有 blogPager.prev/next 键（42 语种已存在），不再新增 i18n 键。
const prevLabel = pick('blogPager.prev') ?? 'Previous'
const nextLabel = pick('blogPager.next') ?? 'Next'

const script = `;(function () {
  function init() {
    // 查询根 = 整个 section：箭头在 section 头、轨道在 section 体，必须同根。
    var section = document.querySelector('[data-scene-section]');
    if (!section) return;
    var track = section.querySelector('.scene-track');
    var prev = section.querySelector('[data-scene-prev]');
    var next = section.querySelector('[data-scene-next]');
    var counter = section.querySelector('[data-scene-counter]');
    if (!track) return;

    // 平滑滚动特性检测（旧 Safari 无 behavior:smooth，降级瞬时滚动）
    var supportsSmooth = 'scrollBehavior' in document.documentElement.style;

    // 页模型：一次点击滚动一个「视口宽」，故
    // 总页数 = ceil(内容总宽 / 视口宽)，当前页 = round(已滚距离 / 视口宽) + 1。
    // 例：scrollWidth 1800、clientWidth 1192 → 总页 2；滚到 608 → round(0.51)+1 = 1。
    function maxScroll() {
      return Math.max(0, track.scrollWidth - track.clientWidth);
    }
    function total() {
      return Math.max(1, Math.ceil(track.scrollWidth / track.clientWidth));
    }
    function update() {
      var page = maxScroll() > 0 ? Math.min(total(), Math.round(track.scrollLeft / track.clientWidth) + 1) : 1;
      if (counter) counter.textContent = page + '–' + total();
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= maxScroll() - 2;
    }
    function go(dir) {
      track.scrollBy({ left: dir * track.clientWidth, behavior: supportsSmooth ? 'smooth' : 'auto' });
    }
    if (prev) prev.addEventListener('click', function () { go(-1); });
    if (next) next.addEventListener('click', function () { go(1); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    // 键盘翻页：焦点落在本区块内时 ←/→ 翻页（与 HeroCarousel 行为一致）
    section.addEventListener('keydown', function (e) {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      if (e.target && /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName)) return;
      e.preventDefault();
      go(e.key === 'ArrowLeft' ? -1 : 1);
    });
    update();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, false);
  else init();
})();`
---

<section class="section section--scenes" data-scene-section>
  <div class="wrap">
    <div class="section-head section-head--row">
      <div>
        <span class="eyebrow">{h.builtTitle}</span>
        <h2>{h.builtTitle}</h2>
        <p class="section-head-sub">{h.builtSub}</p>
      </div>
      <div class="scene-nav">
        <span class="scene-counter" data-scene-counter>1–{scenes.length}</span>
        <button type="button" class="hero-arrow hero-arrow--dark" data-scene-prev aria-label={prevLabel}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="hero-arrow hero-arrow--dark" data-scene-next aria-label={nextLabel}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="wrap scene-root" data-scene-track>
    <div class="scene-track">
      {scenes.map((s) => (
        <a class="scene-card" href={localizedUrl(lang, s.link)}>
          <span class="scene-frame">
            <img src={s.image} alt={pick(s.titleKey) ?? ''} loading="lazy" decoding="async" width="480" height="300" />
          </span>
          <span class="scene-title">{pick(s.titleKey)}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<script is:inline set:html={script} />