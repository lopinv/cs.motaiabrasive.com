---
/**
 * Unified SEO head: TDK + canonical + hreflang + OGP/Twitter + JSON-LD.
 * props: lang, title, description, keywords[], canonicalPath (path without lang, e.g. /products/x),
 *        ogImage (optional url), jsonld (array of objects), robots (default "index,follow")
 */
import { site, localizedUrl } from '../lib/utils.js'
import { LANGS, TRANSLATIONS } from '../lib/i18n.js'
import { hreflangLangs, isTranslated } from '../lib/article-locales.js'

const {
  lang = 'en',
  title,
  description = '',
  keywords = [],
  canonicalPath = '',
  ogImage = '',
  ogType = '',
  jsonld = [],
  robots = 'index,follow',
  articleSlug = ''
} = Astro.props

const meta = TRANSLATIONS[lang]?.meta ?? TRANSLATIONS.en.meta
const siteName = meta.titleSuffix ?? meta.siteName ?? 'MoTai Abrasives'
const htmlLang = TRANSLATIONS[lang]?.htmlLang ?? 'en'
const ogLocale = TRANSLATIONS[lang]?.ogLocale ?? 'en_US'
const path = localizedUrl(lang, canonicalPath)
const canonical = new URL(path, Astro.site ?? 'https://example.com').toString()
const defaultOg = site.logo
// ogLocale fallback must stay BCP47 (xx_XX): use the locale's htmlLang when
// ogLocale is absent, never a bare route code.
const ogLocaleAlternates = LANGS.filter((l) => l !== lang).map((l) => TRANSLATIONS[l]?.ogLocale ?? (TRANSLATIONS[l]?.htmlLang ?? l))
// Regional hreflang variants: Google's es-MX / pt-BR region signals point at
// the existing /es/ and /pt/ sub-sites (no separate localized sub-site).
// 同样受 articleSlug 约束：未译本种不输出区域变体。
const regionVariants = articleSlug
  ? Object.entries({ 'pt-BR': 'pt', 'es-MX': 'es' }).filter(([, target]) => isTranslated(target, articleSlug))
  : Object.entries({ 'pt-BR': 'pt', 'es-MX': 'es' })
// hreflang 互指范围：非文章页 = 全部语种（UI 文案 42 语种已译）；
// 文章页 = 只互指确有该 slug 译文的语种（articleSlug 由调用方传入，
// 未译文条目回退渲染 EN 正文，互指会造成 duplicate content 判定）。
const altLangs = articleSlug ? [...hreflangLangs(articleSlug)] : LANGS
// 品牌后缀统一在此收口：各语种的 tdk 模板串是否带后缀取决于历史写法，
// 这里保证 <title> 一定以 meta.titleSuffix（42 语种已本地化）结尾——
// 但模板串已含该后缀时不重复追加（避免 "墨泰磨料 | MoTai 磨料"）。
const suffix = siteName || ''
const hasSuffix = !!suffix && (title.includes(suffix) || title.endsWith('| ' + suffix))
const fullTitle = hasSuffix || !suffix ? title : `${title} | ${suffix}`
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
{(altLangs ?? LANGS).map((l) => (
  <link
    rel="alternate"
    hreflang={TRANSLATIONS[l].htmlLang}
    href={new URL(localizedUrl(l, canonicalPath), Astro.site ?? 'https://example.com').toString()}
  />
))}
{regionVariants.map(([tag, target]) => (
  <link
    rel="alternate"
    hreflang={tag}
    href={new URL(localizedUrl(target, canonicalPath), Astro.site ?? 'https://example.com').toString()}
  />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localizedUrl('en', canonicalPath), Astro.site ?? 'https://example.com').toString()} />

<meta property="og:type" content={ogType || 'website'} />
<meta property="og:site_name" content={meta.titleSuffix} />
<meta property="og:locale" content={ogLocale} />
{ogLocaleAlternates.map((alt) => <meta property="og:locale:alternate" content={alt} />)}
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:image" content={ogImage || defaultOg} />
<meta property="og:image:alt" content={title} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
<meta name="twitter:image" content={ogImage || defaultOg} />
<meta name="twitter:image:alt" content={title} />
{jsonld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
