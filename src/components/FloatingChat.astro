---
/**
 * 右侧悬浮栏：返回顶部 + WhatsApp 聊天，竖排一组（间距 10px）。
 *
 * 原为两个独立 fixed 元素（各自定位、各自 hover），视觉割裂且定位参数
 * 互相耦合。本组件统一为一个容器：
 *   - .fchat-rail 承载两个圆钮：回顶（浅色，滚动 600px 后淡入）
 *     + 聊天触发（绿色，常驻）
 *   - 聊天窗从聊天钮正上展开（absolute，相对 rail 定位）
 *   - 定位仍在全局吸底条（--quickbar-h）之上，inset-inline-end 单点控制
 *
 * 返回顶部的文案用 quickBar.backToTop（42 语种已译）。
 */
import { TRANSLATIONS } from '../lib/i18n.js'
import { waLink } from '../lib/utils.js'
const { lang, context = 'generic' } = Astro.props
const tr = TRANSLATIONS[lang]
const t = tr.floatChat ?? TRANSLATIONS.en.floatChat
const topLabel = tr.quickBar?.backToTop ?? 'Back to top'
const sendUrl = waLink(lang, context)

const script =
  `;(function () {\n` +
  `  function init() {\n` +
  `    var box = document.querySelector('.fchat');\n` +
  `    if (box) {\n` +
  `      var trigger = box.querySelector('.fchat-trigger');\n` +
  `      var win = box.querySelector('.fchat-window');\n` +
  `      if (!trigger || !win) return;\n` +
  `      var closeBtn = win.querySelector('.wa-close');\n` +
  `      var form = win.querySelector('.wa-form');\n` +
  `      var input = win.querySelector('.wa-input');\n` +
  `      var base = trigger.getAttribute('href') || '';\n` +
  `      var bare = base.split('?')[0];\n` +
  `      function setOpen(v) {\n` +
  `        win.open = v;\n` +
  `        trigger.setAttribute('aria-expanded', v ? 'true' : 'false');\n` +
  `        if (v && input) input.focus({ preventScroll: true });\n` +
  `      }\n` +
  `      trigger.addEventListener('click', function (e) {\n` +
  `        e.preventDefault();\n` +
  `        e.stopPropagation();\n` +
  `        setOpen(!win.open);\n` +
  `      }, false);\n` +
  `      if (closeBtn) closeBtn.addEventListener('click', function () {\n` +
  `        setOpen(false);\n` +
  `        trigger.focus({ preventScroll: true });\n` +
  `      }, false);\n` +
  `      document.addEventListener('keydown', function (e) {\n` +
  `        if (e.key === 'Escape' && win.open) setOpen(false);\n` +
  `      }, false);\n` +
  `      if (form) form.addEventListener('submit', function (e) {\n` +
  `        e.preventDefault();\n` +
  `        var msg = input ? input.value.trim() : '';\n` +
  `        var url = msg ? bare + '?text=' + encodeURIComponent(msg) : base;\n` +
  `        window.open(url, '_blank', 'noopener');\n` +
  `        if (typeof window.gtag === 'function') {\n` +
  `          window.gtag('event', 'whatsapp_click', { link_url: url, has_message: !!msg, source: 'chat-window' });\n` +
  `        }\n` +
  `        if (input) input.value = '';\n` +
  `        setOpen(false);\n` +
  `      }, false);\n` +
  `    }\n` +
  `    initBackToTop();\n` +
  `  }\n` +
  `  // 返回顶部：滚动超过 600px 淡入；点击平滑回顶（尊重减弱动态设置）\n` +
  `  function initBackToTop() {\n` +
  `    var btn = document.querySelector('[data-back-to-top]');\n` +
  `    if (!btn) return;\n` +
  `    var ticking = false;\n` +
  `    function update() {\n` +
  `      ticking = false;\n` +
  `      var show = window.scrollY > 600;\n` +
  `      btn.classList.toggle('is-visible', show);\n` +
  `      btn.setAttribute('aria-hidden', show ? 'false' : 'true');\n` +
  `      btn.tabIndex = show ? 0 : -1;\n` +
  `    }\n` +
  `    window.addEventListener('scroll', function () {\n` +
  `      if (!ticking) { ticking = true; requestAnimationFrame(update); }\n` +
  `    }, { passive: true });\n` +
  `    btn.addEventListener('click', function () {\n` +
  `      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n` +
  `      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });\n` +
  `    });\n` +
  `    update();\n` +
  `  }\n` +
  `  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, false);\n` +
  `  else init();\n` +
  `})();\n`
---

<aside class="fchat" aria-label={t.title}>
    <div class="fchat-rail">
      <button type="button" class="fchat-btn fchat-top" data-back-to-top aria-label={topLabel} aria-hidden="true" tabindex="-1">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 19V5M5 12l7-7 7 7"/>
        </svg>
      </button>
      <a class="fchat-btn fchat-trigger" aria-label={t.open} aria-expanded="false" aria-controls="motai-fchat-window" href={sendUrl} rel="noopener nofollow" target="_blank" title={t.open}>
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.3.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5.6z"/></svg>
      </a>
    </div>
    <details class="fchat-window" id="motai-fchat-window">
    <summary aria-hidden="true" tabindex="-1"></summary>
    <div class="wa-panel">
      <header class="wa-head">
        <span class="wa-dot" aria-hidden="true"></span>
        <div>
          <strong>{t.title}</strong>
          <span class="wa-status">{t.status}</span>
        </div>
        <button class="wa-close" type="button" aria-label={t.close}>✕</button>
      </header>
      <div class="wa-body">
        <p class="wa-greet">{t.greeting}</p>
      </div>
      <form class="wa-form">
        <input class="wa-input" type="text" placeholder={t.placeholder} autocomplete="off" />
        <button class="wa-send" type="submit" aria-label={t.send} title={t.send}>
          <svg aria-hidden="true" fill="none" height="18" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="18"><path d="M14.536 21.686a.5.5 0 0 0 .935-.481V2.795a.5.5 0 0 0-.75-.431L2.5 9.914a1.2 1.2 0 0 0 0 2.172Z"/><path d="M14.5 14 21.5 21.5"/></svg>
        </button>
      </form>
      <p class="wa-note">{t.note}</p>
    </div>
  </details>
</aside>

<script is:inline set:html={script} />
