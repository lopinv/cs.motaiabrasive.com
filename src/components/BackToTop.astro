---
/**
 * 返回顶部：滚动超过阈值后在右下角淡入，点击平滑回顶。
 *
 * 定位避开两个固定件：
 *   - 全局吸底条（--quickbar-h，bottom 0，全宽）
 *   - FloatingChat 圆钮（bottom: calc(var(--quickbar-h) + 16)，右下）
 * 本按钮置于 fchat 圆钮正上方（bottom: calc(var(--quickbar-h) + 76px)），
 * 与圆钮垂直堆叠不重叠。
 *
 * aria-label 沿用既有 quickBar.label（已有 42 语种翻译，不新增键）。
 * 纯原生 JS + CSS 过渡；无 JS 时按钮不显示（内容是回顶功能，无降级损失）。
 */
import { TRANSLATIONS } from '../lib/i18n.js'

const { lang } = Astro.props
const label = TRANSLATIONS[lang]?.quickBar?.label ?? 'Back to top'

const script = `;(function () {
  function init() {
    var btn = document.querySelector('[data-back-to-top]');
    if (!btn) return;
    var ticking = false;
    function update() {
      ticking = false;
      var show = window.scrollY > 600;
      btn.classList.toggle('is-visible', show);
      btn.setAttribute('aria-hidden', show ? 'false' : 'true');
      btn.tabIndex = show ? 0 : -1;
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    btn.addEventListener('click', function () {
      // 尊重减弱动态设置
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    });
    update();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, false);
  else init();
})();`
---

<button type="button" class="back-to-top" data-back-to-top aria-label={label} aria-hidden="true" tabindex="-1">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>

<script is:inline set:html={script} />

<style>
  .back-to-top {
    position: fixed;
    <!-- 位于 FloatingChat 圆钮正上方（fchat: bottom = quickbar + 16，钮高 52） -->
    bottom: calc(var(--quickbar-h) + 78px);
    inset-inline-end: 20px;
    z-index: var(--z-chat);
    width: 44px; height: 44px; padding: 0;
    display: grid; place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--ink-700);
    box-shadow: var(--sh-3);
    cursor: pointer;
    opacity: 0; transform: translateY(8px) scale(.92);
    transition:
      opacity var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .back-to-top.is-visible { opacity: 1; transform: none; }
  .back-to-top svg { width: 18px; height: 18px; }
  .back-to-top:hover { background: var(--ink-800); border-color: var(--ink-800); color: #fff; }
  .back-to-top:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  <!-- 手机端圆钮更小，回顶钮相应上移 -->
  @media (width <= 640px) {
    .back-to-top { bottom: calc(var(--quickbar-h) + 66px); inset-inline-end: 14px; width: 40px; height: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top { transition: none; }
  }
</style>